local Format = require(Shared.Util.Format)

describe("Format", function()
	it("adds thousands separators", function()
		expect(Format.commas(0)).toBe("0")
		expect(Format.commas(999)).toBe("999")
		expect(Format.commas(1000)).toBe("1,000")
		expect(Format.commas(1234567)).toBe("1,234,567")
		expect(Format.commas(-4500)).toBe("-4,500")
	end)

	it("formats chances", function()
		expect(Format.chance(2)).toBe("1 in 2")
		expect(Format.chance(1_000_000)).toBe("1 in 1,000,000")
		expect(Format.chance(0.4)).toBe("1 in 1")
	end)

	it("abbreviates large numbers", function()
		expect(Format.short(950)).toBe("950")
		expect(Format.short(1500)).toBe("1.5K")
		expect(Format.short(2_000_000)).toBe("2M")
		expect(Format.short(250_000)).toBe("250K")
	end)

	it("formats percents and multipliers", function()
		expect(Format.percent(0.25)).toBe("+25%")
		expect(Format.percent(0.025)).toBe("+2.5%")
		expect(Format.multiplier(2)).toBe("x2")
		expect(Format.multiplier(1.5)).toBe("x1.5")
	end)

	it("formats durations", function()
		expect(Format.duration(75)).toBe("1:15")
		expect(Format.duration(3725)).toBe("1:02:05")
		expect(Format.duration(-3)).toBe("0:00")
	end)
end)
